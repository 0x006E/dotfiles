;; defsrc is still necessary
(defcfg
  process-unmapped-keys yes
  ;; NOTE: the NixOS module cannot inject linux-dev when configFile is set,
  ;; so device scoping lives here. Internal AT keyboard only; USB dongle
  ;; kbd interfaces and any external boards stay untouched (add their
  ;; by-path entries here if you want homerow mods on them too).
  linux-dev (/dev/input/by-path/platform-i8042-serio-0-event-kbd)
)
(defsrc
  caps a s d f j k l ;
)
(defvar
  tap-time 200
  hold-time 300
)

(defalias
  escctrl (tap-hold 100 100 esc lctl)
  a (tap-hold $tap-time $hold-time a lmet)
  s (tap-hold $tap-time $hold-time s lalt)
  d (tap-hold $tap-time $hold-time d lsft)
  f (tap-hold $tap-time $hold-time f lctl)
  j (tap-hold $tap-time $hold-time j rctl)
  k (tap-hold $tap-time $hold-time k rsft)
  l (tap-hold $tap-time $hold-time l ralt)
  ; (tap-hold $tap-time $hold-time ; rmet)
)
(deflayer base
  @escctrl @a @s @d @f @j @k @l @;
)
