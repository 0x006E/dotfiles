# The guest's GNOME desktop, as an image.
#
# Built rather than installed at runtime, for three reasons:
#
#   * `dnf group install gnome-desktop` inside a live box takes several minutes
#     on every fresh container, and the box is meant to be created once and kept.
#   * Triggers are skipped only where their products are not needed:
#     tsflags=notriggers stays on the systemd/dbus bootstrap line below
#     (nothing it skips generates an artifact this image lacks, and the line
#     is proven as it stands), while the desktop group install runs stock
#     Fedora triggers. On F44 every file trigger that generates a runtime
#     artifact -- schemas, mime db, icon caches, gio/gtk immodule caches,
#     desktop database, fonts, gdk-pixbuf, ibus -- ends in `|| :` or sits
#     behind `test -d /run/systemd/system`, so it cannot fail a transaction,
#     and the classic systemctl/udevadm triggers are version-gated (dormant
#     on a fresh install) or equally guarded. The udev rules still print
#     `fchownat ... Operation not permitted` noise off the host /dev and the
#     masked udevd -- alarming, but guarded: the transaction completes
#     (verified live). dnf5 cannot scope tsflags any finer than one command
#     anyway (`Invalid tsflag: notriggerprein`), so the line split above is
#     the scoping.
#   * A 2 GB desktop should be describable, diffable and rebuildable rather than
#     be a thing that happened once to a container.
#
# Build and create with ./build.sh (same directory), which also passes the
# device mounts that only exist at container *create* time.
FROM registry.fedoraproject.org/fedora:44

# systemd is the box's init (--init at create time); dbus-daemon is a separate
# package from dbus and is what actually provides the user bus gnome-session
# talks to. Omitting it is the classic way to get a box with no session bus.
# tsflags=notriggers applies to this bootstrap line only (see header).
RUN dnf -y --setopt=tsflags=notriggers install \
      systemd \
      dbus \
      dbus-daemon \
    && dnf clean all

# Fedora 44 ships gnome-shell 50 and mutter 50.5, which is what the whole
# XDG_SESSION_ID + host-logind arrangement was designed and tested against.
# Stock triggers here on purpose: their products (below) are needed.
RUN dnf -y group install -y gnome-desktop \
    && dnf clean all

# Every runtime artifact -- gschemas.compiled, mime.cache, the icon caches,
# gio/gtk immodule caches, mimeinfo.cache, font caches -- comes from the
# group install's own file triggers (see the header); none of it is
# regenerated by hand any more.

# Firefox, in its own layer so the group install above keeps its cache.
# The dash's first favorite (org.mozilla.firefox.desktop) is part of
# Fedora's default favorites; without the package it is an empty slot.
RUN dnf -y install firefox \
    && dnf clean all

# gnome-session@gnome.target pulls in graphical-session.target. Without this the
# target is inactive, RefuseManualStart blocks a direct start, and gnome-session
# exits within a second having started nothing. GDM normally does this; there is
# no GDM here, so the image does it.
#
# In /usr/lib, not ~/.config: the guest's home is bind-mounted from the host, so
# anything the image puts in /home/guest is shadowed at runtime and a drop-in
# written there would quietly stop existing.
RUN mkdir -p /usr/lib/systemd/user/gnome-session@gnome.target.d \
    && printf '[Unit]\nWants=graphical-session.target\nAfter=graphical-session.target\n' \
       > /usr/lib/systemd/user/gnome-session@gnome.target.d/pull-graphical.conf

# Pin the box user manager (linger). It idles out otherwise, and polkit denies
# both uids the `loginctl enable-linger` form -- the file is all linger is.
# Baked in rather than touched at runtime: /var/lib/systemd in the box is the
# container's own writable layer, so this survives with the container.
RUN mkdir -p /var/lib/systemd/linger && touch /var/lib/systemd/linger/guest